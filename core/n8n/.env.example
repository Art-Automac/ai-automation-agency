# ─── Domínios e URLs ─────────────────────────────────────────
N8N_HOST=n8n.seudominio.com.br
N8N_DOMAIN=n8n.seudominio.com.br
N8N_WEBHOOK_DOMAIN=webhook.seudominio.com.br
N8N_WEBHOOK_URL=https://webhook.seudominio.com.br/

# ─── Segurança ───────────────────────────────────────────────
N8N_ENCRYPTION_KEY=gerar_chave_hex_com_openssl_rand_hex_32

# ─── Banco de Dados PostgreSQL ───────────────────────────────
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_USER=n8n
N8N_DB_PASSWORD=sua_senha_do_banco_aqui
N8N_DB_NAME=n8n

# ─── Fila e Cache (Redis / Bull) ─────────────────────────────
N8N_REDIS_HOST=redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=sua_senha_do_redis_aqui
N8N_REDIS_DB=0

# ─── Notificações e E-mail (SMTP) ────────────────────────────
N8N_SMTP_USER=seu_email@gmail.com
N8N_SMTP_PASSWORD=sua_senha_de_app_gmail
