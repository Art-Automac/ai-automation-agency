# ==============================================================================
# Jenkins CI/CD Environment Variables (.env.example)
# ==============================================================================

# Domínio público para acesso ao Jenkins
JENKINS_DOMAIN=jenkins.seudominio.com.br

# Opções de inicialização do Jenkins
JENKINS_OPTS=--httpPort=8080

# Configuração de memória da JVM
JAVA_OPTS=-Djava.awt.headless=true -Xmx1024m -Xms512m
