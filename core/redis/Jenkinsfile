pipeline {
    agent { label 'built-in' }

    environment {
        STACK_NAME   = 'redis'
        COMPOSE_FILE = 'core/redis/redis.yaml'
        IMAGE        = 'redis:7.4'

        REDIS_PASSWORD = credentials('redis-password')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Image') {
            steps {
                sh 'docker pull "${IMAGE}"'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cat <<EOF > core/redis/.env
REDIS_PASSWORD=${REDIS_PASSWORD}
EOF

                    cd core/redis
                    docker stack deploy \
                        --resolve-image always \
                        -c redis.yaml \
                        "${STACK_NAME}"

                    sleep 15
                '''
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "Monitorando inicialização do Redis (até 30 tentativas)..."
                    def success = false

                    for (int i = 1; i <= 30; i++) {
                        sh '''
                            docker stack services "${STACK_NAME}" \
                                --format 'servico={{.Name}} replicas={{.Replicas}}'
                        '''

                        def notReady = sh(
                            script: '''
                                docker stack services "${STACK_NAME}" \
                                    --format '{{.Replicas}}' |
                                    awk -F/ '$1 != $2 {c++} END {print c+0}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Tentativa ${i}/30 — Containers pendentes: ${notReady}"

                        if (notReady == '0') {
                            echo "✅ Sucesso! Redis pronto, saudável e aceitando conexões PONG."
                            success = true
                            break
                        }

                        if (notReady != '0') {
                            sh '''
                                docker service ps "${STACK_NAME}_redis" --no-trunc | head -n 3
                            '''
                        }

                        sleep 10
                    }

                    if (!success) {
                        error "❌ Timeout de 5 minutos — o Redis não subiu com sucesso."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deploy do ${STACK_NAME} concluído com sucesso."
        }
        failure {
            echo "Deploy do ${STACK_NAME} falhou."
        }
        always {
            sh 'rm -f core/redis/.env || true'
        }
    }
}
