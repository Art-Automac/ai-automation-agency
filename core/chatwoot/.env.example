# ==============================================================================
# Chatwoot Environment Variables (.env.example)
# ==============================================================================

# Domínio e Segurança da Aplicação
CHATWOOT_DOMAIN=chat.seudominio.com.br
CHATWOOT_SECRET_KEY=gerar_com_rake_secret_ou_openssl_rand_hex_64

# Banco de Dados PostgreSQL
CHATWOOT_DB_HOST=postgres
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=sua_senha_do_banco_aqui

# Cache e Filas (Redis)
# Formato: redis://:senha@host:porta/db (ex: redis://:minhasenha@redis:6379/1)
CHATWOOT_REDIS_URL=redis://:senha_redis@redis:6379/1

# E-mail e SMTP (ex: Brevo, SendGrid, Amazon SES)
CHATWOOT_SMTP_USERNAME=seu_usuario_smtp
CHATWOOT_SMTP_PASSWORD=sua_senha_smtp
MAILER_INBOUND_EMAIL_DOMAIN=seudominio.com.br

# Integração com Instagram (Meta Developers)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Integração com Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
