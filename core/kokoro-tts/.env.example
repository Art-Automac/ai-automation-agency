# ==============================================================================
# Kokoro TTS Environment Variables (.env.example)
# ==============================================================================

# Domínio e Acesso
TRAEFIK_HOST=tts.seudominio.com.br
KOKORO_API_KEY=sua_api_key_secreta

# Autenticação Básica para o Painel Web (gerado com htpasswd -nb usuario senha)
# Exemplo: admin:$apr1$xyz...
TRAEFIK_BASIC_AUTH=admin:$$apr1$$xyz...
