# ==============================================================================
# Traefik Environment Variables (.env.example)
# ==============================================================================

# E-mail para geração de certificados SSL gratuitos via Let's Encrypt
ACME_EMAIL=admin@seudominio.com.br

# Domínio para acesso ao Dashboard do Traefik
TRAEFIK_DOMAIN=traefik.seudominio.com.br

# Rede overlay externa compartilhada
TRAEFIK_NETWORK=network_public
