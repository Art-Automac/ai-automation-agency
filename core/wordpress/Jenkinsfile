pipeline {
    agent { label 'built-in' }

    environment {
        STACK_NAME   = 'wordpress'
        COMPOSE_FILE = 'core/wordpress/wordpress.yaml'
        IMAGE        = 'wordpress:6-php8.3-apache'

        WP_DOMAIN      = credentials('wp-domain')
        MYSQL_DATABASE = credentials('mysql-database')
        MYSQL_USER     = credentials('mysql-user')
        MYSQL_PASSWORD = credentials('mysql-password')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Image') {
            steps {
                sh 'docker pull "${IMAGE}"'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cat <<EOF > core/wordpress/.env
WP_DOMAIN=${WP_DOMAIN}
MYSQL_DATABASE=${MYSQL_DATABASE}
MYSQL_USER=${MYSQL_USER}
MYSQL_PASSWORD=${MYSQL_PASSWORD}
EOF

                    cd core/wordpress
                    docker stack deploy \
                        --resolve-image always \
                        -c wordpress.yaml \
                        "${STACK_NAME}"

                    sleep 15
                '''
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "Iniciando monitoramento do WordPress (até 30 tentativas)..."
                    def success = false

                    for (int i = 1; i <= 30; i++) {
                        sh '''
                            docker stack services "${STACK_NAME}" \
                                --format 'servico={{.Name}} replicas={{.Replicas}}'
                        '''

                        def notReady = sh(
                            script: '''
                                docker stack services "${STACK_NAME}" \
                                    --format '{{.Replicas}}' |
                                    awk -F/ '$1 != $2 {c++} END {print c+0}'
                            ''',
                            returnStdout: true
                        ).trim()

                        // Teste de requisição HTTP no site WordPress
                        def httpStatus = sh(
                            script: '''
                                curl -k -s -o /dev/null -w "%{http_code}" -m 10 "https://${WP_DOMAIN}" || echo "000"
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Tentativa ${i}/30 — Containers pendentes: ${notReady} | Resposta HTTP: ${httpStatus}"

                        if (notReady == '0' && (httpStatus == '200' || httpStatus == '301' || httpStatus == '302')) {
                            echo "✅ Sucesso! WordPress online e respondendo (HTTP ${httpStatus})."
                            success = true
                            break
                        }

                        if (httpStatus == '404') {
                            echo "⚠️  Traefik aguardando o Apache do WordPress iniciar..."
                        } else if (httpStatus == '500') {
                            echo "⚠️  Erro 500: Verificando se o WordPress conseguiu conectar no MariaDB..."
                        }

                        sleep 10
                    }

                    if (!success) {
                        error "❌ Timeout de 5 minutos — o WordPress não subiu ou não respondeu com sucesso."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deploy do ${STACK_NAME} concluído com sucesso."
        }
        failure {
            echo "Deploy do ${STACK_NAME} falhou."
        }
        always {
            sh 'rm -f core/wordpress/.env || true'
        }
    }
}
