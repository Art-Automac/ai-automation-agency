# ─── Evolution API ───────────────────────────────────────────
EVOLUTION_DOMAIN=evolution.seudominio.com.br
EVOLUTION_API_KEY=sua_chave_global_da_api_aqui
EVOLUTION_CLIENT_NAME=evolution_api

# ─── Banco de Dados PostgreSQL ───────────────────────────────
EVOLUTION_DB_HOST=postgres
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=sua_senha_do_banco_aqui

# ─── Cache e Filas (Redis) ───────────────────────────────────
EVOLUTION_REDIS_URL=redis://:senha_redis@redis:6379/2

# ─── WhatsApp Business API (Meta Oficial - Opcional) ─────────
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_VERSION=v20.0
