pipeline {
    agent { label 'built-in' }

    environment {
        STACK_NAME   = 'postgres'
        COMPOSE_FILE = 'core/postgres/postgres.yaml'
        IMAGE        = 'pgvector/pgvector:pg17'

        POSTGRES_USER     = credentials('postgres-user')
        POSTGRES_PASSWORD = credentials('postgres-password')
        POSTGRES_DB       = credentials('postgres-db')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Pull Image') {
            steps {
                sh 'docker pull "${IMAGE}"'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cat <<EOF > core/postgres/.env
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}
EOF

                    cd core/postgres
                    docker stack deploy \
                        --resolve-image always \
                        -c postgres.yaml \
                        "${STACK_NAME}"

                    sleep 15
                '''
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "Iniciando monitoramento do PostgreSQL (até 30 tentativas)..."
                    def success = false

                    for (int i = 1; i <= 30; i++) {
                        sh '''
                            docker stack services "${STACK_NAME}" \
                                --format 'servico={{.Name}} replicas={{.Replicas}}'
                        '''

                        def notReady = sh(
                            script: '''
                                docker stack services "${STACK_NAME}" \
                                    --format '{{.Replicas}}' |
                                    awk -F/ '$1 != $2 {c++} END {print c+0}'
                            ''',
                            returnStdout: true
                        ).trim()

                        echo "Tentativa ${i}/30 — Containers pendentes: ${notReady}"

                        if (notReady == '0') {
                            echo "✅ Sucesso! PostgreSQL pronto e saudável."
                            success = true
                            break
                        }

                        if (notReady != '0') {
                            sh '''
                                docker service ps "${STACK_NAME}_postgres" --no-trunc | head -n 3
                            '''
                        }

                        sleep 10
                    }

                    if (!success) {
                        error "❌ Timeout de 5 minutos — o PostgreSQL não subiu com sucesso."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deploy do ${STACK_NAME} concluído com sucesso."
        }
        failure {
            echo "Deploy do ${STACK_NAME} falhou."
        }
        always {
            sh 'rm -f core/postgres/.env || true'
        }
    }
}
