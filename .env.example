# ==============================================================================
# Core Infrastructure — Master Environment Template (.env.example)
#
# Copie este arquivo ou use os arquivos .env.example individuais em:
#   - core/<servico>/.env.example
#   - monitoring/<servico>/.env.example
#
# NUNCA commite arquivos .env preenchidos com valores reais no repositório!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE / GESTÃO E ROTEAMENTO
# ------------------------------------------------------------------------------

# Traefik
ACME_EMAIL=admin@seudominio.com.br
TRAEFIK_DOMAIN=traefik.seudominio.com.br
TRAEFIK_NETWORK=network_public

# Jenkins CI/CD
JENKINS_DOMAIN=jenkins.seudominio.com.br
JENKINS_OPTS=--httpPort=8080
JAVA_OPTS=-Djava.awt.headless=true -Xmx1024m -Xms512m

# Portainer CE
PORTAINER_DOMAIN=portainer.seudominio.com.br

# ------------------------------------------------------------------------------
# 2. DADOS E CACHE
# ------------------------------------------------------------------------------

# PostgreSQL 17 + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_postgres
POSTGRES_DB=postgres

# pgAdmin 4
PGADMIN_DOMAIN=pgadmin.seudominio.com.br
PGADMIN_EMAIL=admin@seudominio.com.br
PGADMIN_PASSWORD=sua_senha_segura_pgadmin

# MariaDB 11.8 (WordPress)
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=sua_senha_usuario_mariadb
MYSQL_ROOT_PASSWORD=sua_senha_root_mariadb

# Redis 7.4
REDIS_PASSWORD=sua_senha_segura_redis

# ------------------------------------------------------------------------------
# 3. APLICAÇÕES
# ------------------------------------------------------------------------------

# n8n Workflow Automation
N8N_HOST=n8n.seudominio.com.br
N8N_DOMAIN=n8n.seudominio.com.br
N8N_WEBHOOK_DOMAIN=webhook.seudominio.com.br
N8N_WEBHOOK_URL=https://webhook.seudominio.com.br/
N8N_DB_HOST=postgres
N8N_DB_PORT=5432
N8N_DB_USER=n8n
N8N_DB_PASSWORD=sua_senha_db_n8n
N8N_DB_NAME=n8n
N8N_REDIS_HOST=redis
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=sua_senha_segura_redis
N8N_REDIS_DB=1
N8N_ENCRYPTION_KEY=gere_com_openssl_rand_hex_32
N8N_SMTP_HOST=smtp.seudominio.com.br
N8N_SMTP_PORT=587
N8N_SMTP_USER=seu_email@seudominio.com.br
N8N_SMTP_PASSWORD=sua_senha_smtp

# Evolution API v2 (WhatsApp)
EVOLUTION_DOMAIN=evolution.seudominio.com.br
EVOLUTION_API_KEY=gere_uma_chave_longa_e_segura
EVOLUTION_CLIENT_NAME=evolution_api
EVOLUTION_DB_HOST=postgres
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=sua_senha_db_evolution
EVOLUTION_REDIS_URL=redis://:sua_senha_segura_redis@redis:6379/2
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_VERSION=v20.0

# Chatwoot Omnichannel
CHATWOOT_DOMAIN=chat.seudominio.com.br
CHATWOOT_SECRET_KEY=gere_com_openssl_rand_hex_64
CHATWOOT_DB_HOST=postgres
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=sua_senha_db_chatwoot
CHATWOOT_REDIS_URL=redis://:sua_senha_segura_redis@redis:6379/3
CHATWOOT_SMTP_USERNAME=seu_email@seudominio.com.br
CHATWOOT_SMTP_PASSWORD=sua_senha_smtp
MAILER_INBOUND_EMAIL_DOMAIN=seudominio.com.br
SMTP_ADDRESS=smtp.seudominio.com.br
SMTP_PORT=587
INSTALLATION_NAME=SuaEmpresa
BRAND_NAME=SuaEmpresa
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kokoro TTS (Neural Voice API)
TRAEFIK_HOST=tts.seudominio.com.br
KOKORO_API_KEY=sua_api_key_secreta_kokoro
TRAEFIK_BASIC_AUTH=admin:$$apr1$$exemplo_hash_htpasswd

# WordPress
WP_DOMAIN=seudominio.com.br

# ------------------------------------------------------------------------------
# 4. MONITORAMENTO E OBSERVABILIDADE
# ------------------------------------------------------------------------------

# Grafana
GRAFANA_HOST=grafana.seudominio.com.br
GRAFANA_USER=admin
GRAFANA_PASSWORD=sua_senha_segura_grafana

# Prometheus
PROMETHEUS_HOST=prometheus.seudominio.com.br

# Exporters
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
IP_MANAGER_1=10.0.0.1
IP_WORKER_1=10.0.0.2
